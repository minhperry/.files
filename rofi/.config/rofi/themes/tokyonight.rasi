/*
 * Tokyonight colorscheme for rofi
 * User: w8ste
 */


// define colors etc.
oldglobal {
    background: #24283bff;
    background2: #2e3350;
    accent: #29758b; 
    primary: #C5C8C6; 
    text-color: @primary;
    text-selected: #8fbedd;

    font: "Monospace 11";
    background-color: @background;

    border: 0px;
    bordercolor: #6c90be9f;

    transparent: rgba(46,52,64,0);
}

* {
    background:     #1f2335ff; /* Soft, atmospheric storm blue */
    background2:    #24283bff; /* Slightly lighter tone for the input bar */
    accent:         #2f334dff; /* Deep, low-contrast twilight selection bar */
    primary:        #a9b1d6ff; /* Soft, desaturated lavender-gray text */
    text-color:     @primary;
    text-selected:  #cbccd1ff; /* Slightly brighter text when selected */
    bordercolor:    #3b4261ff; /* Subtle, dark slate border */
}

* {
    font: "Monospace 11";
    background-color: @background;
}

// defines different aspects of the window
window {
    width: 800;
    /*since line wont work with height, i comment it out 
    if you rather control the size via height
    just comment it out */
    //height: 500;

    orientation: horizontal;
    location: center;
    anchor: center;
    transparency: "screenshot";
    border-color: @bordercolor;   
    border: 2px;
    border-radius: 8px;
    spacing: 0;
    children: [ mainbox ];
}

mainbox {
    spacing: 0;
    children: [ inputbar, message, listview, mode-switcher ];
}

// 4-padding: top right bottom left
// 2-padding: top/bottom left/right


// ------------ Inputbar ------------
inputbar {
    color: @text-color;
    padding: 10px;
    margin: 15px 15px 10px 15px;
    //border: 1px;
    border-radius: 4px;
    border-color: @bordercolor;
    background-color: @background2;
    children: [ icon-search, entry/*, case-indicator*/ ];
}

icon-search {
    expand: false;
    filename: "search";
    size: 24px;
    background-color: transparent;
    margin: -4px 0 0 0;
    vertical-align: 0.5;
}

entry, prompt {
    font: inherit;
    color: inherit;
    background-color: inherit;
}

entry {
    cursor: pointer;
    color: #8d8d8def;
}

prompt {
    margin: 0px 5px 0px 0px;
    font: "mono 14";
}

case-indicator {
    text-color: @accent;
}

// ------------ Message ------------

message {
    padding: 0;
}

textbox {
    color: @text-color;
    padding: 10px;
}

// ------------ Listview ------------

listview {
    layout: vertical;
    //spacing: 30px;
    padding: 0 15px 10px 15px;
    lines: 10;
    columns: 1;
    dynamic: true;
    // scrollbar: true;
}

element {
    padding: 8px 10px;
    margin: 0;
    vertical-align: 1;
    color: @text-color;
    font: inherit;
    border-radius: 4px;
}

element-text {
    background-color: inherit;
    text-color: inherit;
}

element selected.normal {
    color: @text-selected;
    background-color: @accent;
}

element normal active {
    background-color: @accent;
    color: @text-selected;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

element normal urgent {
    background-color: @primary;
}

element selected active {
    background: @accent;
    foreground: @background;
}

element-icon {
    size: 1.1em;
}

mode-switcher {
    background-color: transparent;
    padding: 10px 15px 15px 15px; /* Aligns perfectly with your layout padding */
    spacing: 10px;                /* Gap between the tab buttons */
    margin: 0 0 10px 0;
}

button {
    padding: 8px;
    background-color: @background2; /* Inactive tab matches inputbar */
    text-color: @primary;
    border-radius: 4px;
    vertical-align: 0.5;
    horizontal-align: 0.5;
    font: "mono 16";
}

button selected normal {
    background-color: @accent;      /* Active tab uses your subtle accent selection color */
    text-color: @text-selected;     /* Active tab text highlight */
}

scrollbar {
    width: 4px;
    border: 0;
    handle-width: 4px;
    handle-color: @accent;
    background-color: @background2;
}