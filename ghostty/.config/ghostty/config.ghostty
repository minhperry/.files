# Mirrors the effective kitty setup (kitty.conf + tokyo.conf)

command = zsh -l

# Fonts
font-family = MesloLGS NF
font-size = 11

# Window
window-padding-x = 6
window-padding-y = 6
window-padding-balance = true
background-opacity = 0.92
background-blur = false
gtk-titlebar = false
window-show-tab-bar = auto

# Cursor
cursor-style = block
cursor-style-blink = false
cursor-color = #c0caf5
cursor-text = #1a1b26

# Tokyo Night colors
foreground = #a9b1d6
background = #1a1b26
selection-foreground = cell-foreground
selection-background = #28344a

palette = 0=#414868
palette = 1=#f7768e
palette = 2=#73daca
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#7dcfff
palette = 7=#c0caf5
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#73daca
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5
