{
    "battery": {
        "format": "<span color='#7dcfff'>{icon}</span>  {capacity}%",
        "format-full": "<span color='#7dcfff'>{icon}</span>  {capacity}%",
        "format-charging": "<span color='#7dcfff'>󰃨</span>  {capacity}%",
        "format-plugged": "<span color='#7dcfff'></span>  {capacity}%",
        "format-alt": "{time} {icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "full-at": 99,
        "interval": 60,
        "tooltip": false
    }
}
