{
  "network": {
    "format-ethernet": "<span color='#9ece6a'>󰁞</span> {bandwidthUpBytes:>5}  <span color='#f7768e'>󰁆</span> {bandwidthDownBytes:>5}",
    "format-wifi": "<span color='#9ece6a'>󰁞</span> {bandwidthUpBytes:>5}  <span color='#f7768e'>󰁆</span> {bandwidthDownBytes:>5}",
    "format-disconnected": "<span color='#707880'></span>",
    "interval": 1,
    // "tooltip": false
  },
  "custom/bandwidth": {
    "exec": "$HOME/.config/waybar/scripts/bandwidth.py"
  }
}
