{
    "group/group-power": {
      "orientation": "inherit",
      "drawer": {
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false
      },
      "modules": [
        "custom/power", // First element is the "group leader" and won't ever be hidden
        "custom/quit",
        "custom/lock",
        "custom/reboot",
        "custom/suspend"
      ]
    },
    "custom/quit": {
      "format": "󰗼",
      "tooltip": false,
      "on-click": "niri msg action quit"
    },
    "custom/lock": {
      "format": "󰍁",
      "tooltip": false,
      "on-click": "hyprlock -q"
    },
    "custom/reboot": {
      "format": "󰜉",
      "tooltip": false,
      "on-click": "systemctl reboot"
    },
    "custom/power": {
      "format": "",
      "tooltip": false,
      "on-click": "systemctl poweroff"
    },
    "custom/suspend": {
      "format": "󰤂",
      "tooltip": false,
      "on-click": "sh -c 'hyprlock -q & sleep 0.2; systemctl suspend'"
    },
    "custom/wlogout": {
      "format": "",
      "tooltip": false,
      "on-click": "wlogout"
    }
    /*
    =============== TODO ===============
    Install wleave/wlogout in place
    */
}
