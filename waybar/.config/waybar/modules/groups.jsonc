{
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": false
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider",
      "pulseaudio#microphone"
    ],
    "tooltip": false
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "cpu",
      "temperature"
    ]
  },
  "group/distro-group": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 650,
      "transition-left-to-right": true
    },
    "modules": [
      "custom/distro",
      "custom/terminal",
      "custom/code",
      "custom/office",
      "custom/files",
      "custom/browser"
    ]
  }
}