{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,

    "modules-left": ["custom/window"],
    "modules-center": ["clock"],
    "modules-right": [
        "custom/keyboard",
        "custom/sep",
        "keyboard-state#caps",
        "keyboard-state#num",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "cpu",
        "custom/sep",
        "memory",
        "custom/sep",
        "network",
        "custom/sep",
        "battery",
        "tray"
    ],

    // ── Left ──────────────────────────────────────────────────────────────

    "custom/window": {
        "exec": "~/.config/waybar/scripts/window.sh",
        "interval": 2,
        "tooltip": false
    },

    // ── Center ────────────────────────────────────────────────────────────

    "clock": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "format-alt": "{:%d.%m.%Y %H:%M:%S}",
        "tooltip": false
    },

    // ── Right ─────────────────────────────────────────────────────────────

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "custom/keyboard": {
        "exec": "~/.config/waybar/scripts/keyboard.sh",
        "interval": 1,
        "on-click": "fcitx5-remote -t",
        "tooltip": false
    },

    "keyboard-state#caps": {
        "capslock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "A",
            "unlocked": "a"
        },
        "tooltip": false
    },

    "keyboard-state#num": {
        "numlock": true,
        "format": "{icon}",
        "format-icons": {
            "locked": "#",
            "unlocked": "#"
        },
        "tooltip": false
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "    0%",
        "on-click": "pavucontrol",
        "scroll-step": 5,
        "tooltip": false
    },

    "cpu": {
        "format": "  {usage:2}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "  {used:0.1f}G",
        "interval": 2,
        "tooltip": false
    },

    "network": {
        "format-ethernet": "󰁞 {bandwidthUpBytes}  󰁆 {bandwidthDownBytes}",
        "format-wifi": "󰁞 {bandwidthUpBytes}  󰁆 {bandwidthDownBytes}",
        "format-disconnected": "disconnected",
        "interval": 2,
        "tooltip": false
    },

    "battery": {
        "format": "{icon}  {capacity}%",
        "format-charging": "󰁹  {capacity}%",
        "format-full": "  Full",
        "format-icons": ["", "", "", "", ""],
        "states": {
            "warning": 30,
            "critical": 15
        },
        "full-at": 99,
        "interval": 5,
        "tooltip": false
    },

    "tray": {
        "spacing": 8
    }
}
