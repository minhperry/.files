(include "widgets/cont.yuck")

(
  ; equiv: fn greeter(name, text=null)  
  defwidget greeter [?text name]
  (
    ; style definition
    box :orientation "horizontal"
       :halign "center"
    ; 
    text
    (button :onclick "notify-send 'Hello' 'Hello, ${name}'"
      "Greet")
  )
)

(
  defwidget examplebar []
  (
    centerbox :orientation "horizontal"
    (
      greeter
      :text "Fuck you"
      :name "Balls"
    )
    (
      greeter
      :text "Fuck you"
      :name "Balls"
    )
    (
      labeled-container :name "foo"
        (button :onclick "notify-send hey ho" "click me")
    )
  )
)